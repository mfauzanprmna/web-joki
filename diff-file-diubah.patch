--- a/prisma/schema.prisma
+++ b/prisma/schema.prisma
@@ model Customer
   publicSlug String  @unique
   createdAt DateTime @default(now())
   updatedAt DateTime @updatedAt
 
   orders Order[]
+  jokiHistoryEntries JokiHistoryEntry[]
 }
@@ model JokiHistoryEntry
 model JokiHistoryEntry {
   id             String   @id @default(cuid())
   gameId         String
   game           Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
   title          String // nama joki/paket yang dikerjakan, mis. "Push Rank Mythic"
-  customerName   String
+  /// Sama seperti Order -- pilih Customer yang sudah ada atau buat baru, BUKAN
+  /// teks bebas, supaya history manual ini tergabung dengan riwayat order asli
+  /// milik customer yang sama (lihat /admin/customer).
+  customerId     String
+  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
   jokerName      String?
   completedAt    DateTime
   rating         Int? // opsional, 1-5 -- rating/catatan cepat dari admin sendiri
   note           String? // catatan/testimoni singkat
   screenshotUrls String[] @default([])
   shareToken     String   @unique @default(cuid())
   createdAt      DateTime @default(now())
 
   testimonial Testimonial?
 
   @@index([gameId])
   @@index([completedAt])
+  @@index([customerId])
 }
@@ -63,3 +63,76 @@ body {
 .admin-input:focus {
   border-color: #ffb238;
 }
+
+/* Animasi untuk SweetAlert-style modal & komponen loading. */
+@keyframes shihu-fade-in {
+  from {
+    opacity: 0;
+  }
+  to {
+    opacity: 1;
+  }
+}
+
+@keyframes shihu-pop-in {
+  from {
+    opacity: 0;
+    transform: scale(0.92) translateY(6px);
+  }
+  to {
+    opacity: 1;
+    transform: scale(1) translateY(0);
+  }
+}
+
+@keyframes shihu-spin {
+  to {
+    transform: rotate(360deg);
+  }
+}
+
+@keyframes shihu-bar-indeterminate {
+  0% {
+    transform: translateX(-100%) scaleX(0.4);
+  }
+  50% {
+    transform: translateX(20%) scaleX(0.6);
+  }
+  100% {
+    transform: translateX(120%) scaleX(0.4);
+  }
+}
+
+.animate-shihu-fade-in {
+  animation: shihu-fade-in 0.18s ease-out;
+}
+
+.animate-shihu-pop-in {
+  animation: shihu-pop-in 0.22s cubic-bezier(0.16, 1, 0.3, 1);
+}
+
+.animate-shihu-spin {
+  animation: shihu-spin 0.7s linear infinite;
+}
+
+.shihu-topbar {
+  position: fixed;
+  top: 0;
+  left: 0;
+  right: 0;
+  height: 3px;
+  z-index: 200;
+  overflow: hidden;
+  background: transparent;
+  pointer-events: none;
+}
+
+.shihu-topbar-fill {
+  position: absolute;
+  inset: 0;
+  width: 40%;
+  border-radius: 9999px;
+  background: linear-gradient(90deg, #ffb238, #ff7a45, #a385ff);
+  animation: shihu-bar-indeterminate 1.1s ease-in-out infinite;
+  box-shadow: 0 0 12px 1px rgba(255, 178, 56, 0.55);
+}
